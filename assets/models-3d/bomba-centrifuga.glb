<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Generador GLB — Bomba Centrífuga</title>
</head>
<body style="font-family: sans-serif; padding: 24px; background: #0B192C; color: #fff;">
  <h2>Exportador CAD a Binario (.glb) — Bomba Centrífuga de Pulpa</h2>
  <button id="btn-export" style="padding: 12px 20px; font-size: 16px; cursor: pointer;">
    ⬇ Descargar bomba-centrifuga.glb
  </button>

  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/exporters/GLTFExporter.js"></script>
  <script>
    function buildBombaCentrifuga() {
      const root = new THREE.Group();
      root.name = "Ensamble_Bomba_Centrifuga";

      const matVoluta = new THREE.MeshStandardMaterial({ color: 0x1E3A5F, metalness: 0.65, roughness: 0.35 });
      const matImpulsor = new THREE.MeshStandardMaterial({ color: 0x0095D9, metalness: 0.75, roughness: 0.25 });
      const matAcero = new THREE.MeshStandardMaterial({ color: 0xCBD5E1, metalness: 0.85, roughness: 0.2 });
      const matBronce = new THREE.MeshStandardMaterial({ color: 0xD97706, metalness: 0.8, roughness: 0.3 });

      // 1. Base estructural
      const base = new THREE.Mesh(new THREE.BoxGeometry(3.4, 0.25, 1.4), matVoluta);
      base.name = "Base_Estructural_Planta";
      base.position.set(0, -1.05, 0);
      root.add(base);

      // 2. Carcasa Voluta
      const voluta = new THREE.Mesh(new THREE.CylinderGeometry(0.95, 0.95, 0.65, 32), matVoluta);
      voluta.name = "Carcasa_Voluta_Hierro_Alto_Cromo";
      voluta.rotation.z = Math.PI / 2;
      voluta.position.set(-0.95, 0, 0);
      root.add(voluta);

      // Brida de descarga superior
      const descarga = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.26, 0.75, 24), matVoluta);
      descarga.name = "Boquilla_Descarga_Vertical";
      descarga.position.set(-0.95, 0.92, 0.35);
      root.add(descarga);

      // 3. Impulsor cerrado
      const impulsor = new THREE.Mesh(new THREE.CylinderGeometry(0.72, 0.72, 0.28, 24), matImpulsor);
      impulsor.name = "Impulsor_Cerrado_5_Alabes";
      impulsor.rotation.z = Math.PI / 2;
      impulsor.position.set(-0.95, 0, 0);
      root.add(impulsor);

      // 4. Caja de rodamientos
      const cajaRod = new THREE.Mesh(new THREE.CylinderGeometry(0.42, 0.46, 1.35, 24), matVoluta);
      cajaRod.name = "Caja_Rodamientos_Lado_Acople";
      cajaRod.rotation.z = Math.PI / 2;
      cajaRod.position.set(0.35, 0, 0);
      root.add(cajaRod);

      // 5. Eje escalonado SAE 4140
      const eje = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 2.75, 24), matAcero);
      eje.name = "Eje_Escalonado_SAE_4140";
      eje.rotation.z = Math.PI / 2;
      eje.position.set(0.15, 0, 0);
      root.add(eje);

      // 6. Rodamientos de contacto angular
      const rod1 = new THREE.Mesh(new THREE.TorusGeometry(0.24, 0.07, 16, 32), matBronce);
      rod1.name = "Rodamiento_Contacto_Angular_7314";
      rod1.rotation.y = Math.PI / 2;
      rod1.position.set(-0.15, 0, 0);
      root.add(rod1);

      const rod2 = rod1.clone();
      rod2.name = "Rodamiento_Cilindrico_NU314";
      rod2.position.set(0.85, 0, 0);
      root.add(rod2);

      // 7. Polea conducida en V
      const polea = new THREE.Mesh(new THREE.CylinderGeometry(0.55, 0.55, 0.24, 32), matAcero);
      polea.name = "Polea_Conducida_Perfil_5V";
      polea.rotation.z = Math.PI / 2;
      polea.position.set(1.38, 0, 0);
      root.add(polea);

      return root;
    }

    document.getElementById("btn-export").addEventListener("click", () => {
      const scene = new THREE.Scene();
      scene.add(buildBombaCentrifuga());

      const exporter = new THREE.GLTFExporter();
      exporter.parse(
        scene,
        (glbBuffer) => {
          const blob = new Blob([glbBuffer], { type: "model/gltf-binary" });
          const link = document.createElement("a");
          link.href = URL.createObjectURL(blob);
          link.download = "bomba-centrifuga.glb";
          link.click();
        },
        { binary: true }
      );
    });
  </script>
</body>
</html>
